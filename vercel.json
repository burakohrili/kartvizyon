{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace @kartvizyon/web",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/internal/retention/audio",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/privacy/process",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/webhooks/deliver",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/documents/dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/subscriptions/expire-trials",
      "schedule": "30 3 * * *"
    }
  ]
}
